		{
			"name": "Remove Product from Cart",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Товар успешно удалён\", function () {\r",
							"    let jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.status).to.eql(\"ok\");\r",
							"    pm.expect(jsonData.sum_quantity).to.eql(\"0\");\r",
							"    pm.expect(jsonData.products_amount).to.eql(0);\r",
							"});\r",
							"\r",
							"console.log(\"Ответ API:\", pm.response.text());\r",
							"\r",
							"\r",
							"pm.test(\"Статус ответа 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
